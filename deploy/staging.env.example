# Copy to staging.env (never commit that file) and fill in what you need.
# A staging copy runs fine with none of these: mail just does not send and
# no coach's read is written.

# COUNTERPLAY_SITE_URL=https://staging.counterplaycs.com
# COUNTERPLAY_SMTP_HOST=
# COUNTERPLAY_SMTP_PORT=
# COUNTERPLAY_SMTP_USER=
# COUNTERPLAY_SMTP_PASSWORD=
# COUNTERPLAY_MAIL_FROM=

# Use a SEPARATE Anthropic key with its own spend limit, not production's.
# ANTHROPIC_API_KEY=
