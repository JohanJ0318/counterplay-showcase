# Data. The database and demos are the product's state, not its source — they
# are large, they are regenerated by parsing, and counterplay.db holds real
# accounts. `deploy/backup.sh` is what protects them, not git.
data/
backups/
transfer.db

# Fetched, not authored. Valve's map overview images are downloaded by
# `counterplay.radar --fetch` so this repository carries none of their artwork.
site/radars/

# Generated pages, rebuilt from the database on demand.
site/zones.html
site/nuke-zones.html
site/finish-zones.html
site/league/

# The same generated pages after the league section was taken off the site.
# 980 files, 25MB, rebuilt from league/gen in about a minute. archive/README.md
# is the part worth keeping: it says what was removed and how to restore it.
archive/site-league/

# The league API cache: 27MB of somebody else's data.
league/gen/cache/

.venv/
__pycache__/
*.pyc
*.log

# The code graph. Rebuilt from source by `graphify update .`, so it is output
# rather than source: graph.json alone is megabytes and changes on every edit.
# .mcp.json IS tracked, because the server config is worth sharing.
graphify-out/

# A staging copy's secrets (deploy/staging.env.example says what goes in it).
deploy/staging.env
